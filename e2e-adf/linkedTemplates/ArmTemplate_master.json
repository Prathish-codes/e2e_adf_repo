{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "e2e-adf"
		},
		"LS_ADLS_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LS_ADLS'"
		},
		"LS_ADLS_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://e2eproject.dfs.core.windows.net/"
		},
		"LS_PostgreSQL_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "ep-purple-scene-b33qhld9-pooler.c-4.ap-southeast-1.aws.neon.tech"
		},
		"LS_PostgreSQL_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "neondb"
		},
		"LS_PostgreSQL_properties_typeProperties_username": {
			"type": "string",
			"defaultValue": "neondb_owner"
		},
		"LS_key_vault_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://caresynckeyvault12.vault.azure.net/"
		},
		"ls_AzureSqlDatabase1_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "caresync-server12.database.windows.net"
		},
		"ls_AzureSqlDatabase1_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "sql-db-caresync"
		},
		"ls_AzureSqlDatabase1_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "prathish"
		},
		"LS_AzureDatabricks1_properties_typeProperties_existingClusterId": {
			"type": "string",
			"defaultValue": "0928-153405-dsg2dorf"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "e2e-adf_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_ADLS_accountKey": {
						"value": "[parameters('LS_ADLS_accountKey')]"
					},
					"LS_ADLS_properties_typeProperties_url": {
						"value": "[parameters('LS_ADLS_properties_typeProperties_url')]"
					},
					"LS_key_vault_properties_typeProperties_baseUrl": {
						"value": "[parameters('LS_key_vault_properties_typeProperties_baseUrl')]"
					},
					"LS_PostgreSQL_properties_typeProperties_server": {
						"value": "[parameters('LS_PostgreSQL_properties_typeProperties_server')]"
					},
					"LS_PostgreSQL_properties_typeProperties_database": {
						"value": "[parameters('LS_PostgreSQL_properties_typeProperties_database')]"
					},
					"LS_PostgreSQL_properties_typeProperties_username": {
						"value": "[parameters('LS_PostgreSQL_properties_typeProperties_username')]"
					},
					"ls_AzureSqlDatabase1_properties_typeProperties_server": {
						"value": "[parameters('ls_AzureSqlDatabase1_properties_typeProperties_server')]"
					},
					"ls_AzureSqlDatabase1_properties_typeProperties_database": {
						"value": "[parameters('ls_AzureSqlDatabase1_properties_typeProperties_database')]"
					},
					"ls_AzureSqlDatabase1_properties_typeProperties_userName": {
						"value": "[parameters('ls_AzureSqlDatabase1_properties_typeProperties_userName')]"
					},
					"LS_AzureDatabricks1_properties_typeProperties_existingClusterId": {
						"value": "[parameters('LS_AzureDatabricks1_properties_typeProperties_existingClusterId')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}